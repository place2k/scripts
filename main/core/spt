#!/usr/bin/bash

# =========================== ARGUMENTLESS COMMANDS ===========================

spt_usage() {
  echo "spt $SPT_VERSION — Scripts Manager"
  echo

  echo "USAGE"
  echo "  $SPT_THIS [help|usage|version]"
  echo "  $SPT_THIS [list|enumgen|sync|perms|help|config]"
  echo "  $SPT_THIS list [scriptname pattern]"
  echo "  $SPT_THIS [edit|del|view|enum] [script identifier] ..."
  echo "  $SPT_THIS enum ... [script number range]           ..."
  echo "  $SPT_THIS rename   [script identifier] [new name]  ..."
  echo "  $SPT_THIS link     [script identifier] [link name] ..."
  echo "  $SPT_THIS config   -l | [section/]name[=value]     ..."
  echo "  $SPT_THIS config [option...] [section/]name=value... -- [command] [argument...]"
}

help_text() {
  [[ $1 == -e ]] && spt_error --up 2 "$2"

  spt_usage
  test -n ${SPTCFG[editor/gui]} && local GUI_EDITOR="($_) "
  printf '\n\nCOMMANDS\n\n'

  echo 'edit (edit or create script files):'
  echo '  -c, --cli         use the CLI text editor, overriding any configuration that says otherwise'
  echo "  -g, --gui         use the graphical text editor ${GUI_EDITOR}instead of the CLI one (${SPTCFG[editor/cli]})"
  echo '  -f, --first       select for editing the first pattern-matched file only'
  echo '  -l, --last        select the last file only'
  echo '  -a, --all         select for editing all pattern-matched files'
  echo '  -L, --line LINE   open file at the specified line, or at the beginning (line 1) if no line is given'
  echo '  -b, --bang ARGS   use the given interpreter (and its arguments, if any; all in one string) on the shebang line for new files'
  echo '  -B, --nobang      do not automatically insert a shebang line in new files'
  echo 'del (delete one or more [or all] script files):'
  echo '  -y, --yes         delete the given script(s) immediately, without asking for confirmation; ignored when `all` is given as script'
  echo '  -c, --confirm     prompt the user for confirmation before deleting each and every script'
  echo '  -o, --ask-once    prompt the user for confirmation only once before deleting the given script(s)'
  echo 'view (view the code of one or more [or all] scripts):'
  echo '  -L, --least       use cat(1) instead of bat(1) to view the script source code'
  echo '  -l, --less        use less(1) instead of bat(1) to view the script source code'
  echo '  -m, --more        use bat(1), without line numbers or paging, to view the script source code'
  echo '  -M, --most        use bat(1) to view the script source code'
  echo 'list (list script files):'
  echo '  -s, --scripts     list the original scripts files instead of the backup ones'
  echo '  -b, --backup      list the script backup files instead of the original ones'
  echo '  -B, --both        list both original and backup script files'
  echo '  -n, --name        sort script files by name; show relative dates'
  echo '  -d, --adate       sort script files by date; show absolute dates'
  echo '  -D, --rdate       sort script files by date; show relative dates'
  echo 'link (create a scriptname that is a symbolic link to a scriptfile):'
  echo '  -f, --force       create a link even if one already exists to the given scriptfile'
  echo '  -o, --onelink     do not create a link if a scriptfile already has one'
  echo '  -s, --symbolic    create/delete symbolic links only'
  echo '  -l, --hard        create/delete hard links only'
  echo '  -c, --chain       allow creation of symbolic links to symbolic links'
  echo '  -C, --no-chain    do not create a symbolic link to a scriptname if it is a symbolic link itself'
  echo '  -u, --unlink      delete one or more links; unlike `del`, this will delete neither the target nor all associated links at once'
  echo 'config (list mode: print every valid configuration name):'
  echo '  -l, --list        print all the valid configuration names in a section/name format, then exit; with -F/--full, print also the =value'
  echo '  -F, --full        print the =value too when listing with -l/--list'
  echo 'config (get/set mode: read/write configuration value[s]):'
  echo '  -m, --match       get or set the value of every configuration whose name (and/or section) matches the given one'
  echo '  -f, --fail        exit with error (do not persist, nor execute a command line) if the given configuration name does not exist'
  echo '  -F, --full        (get mode only) print in full format (section/name=value), rather than printing only the value'
  echo "  -p, --persist     (write mode only) persist modified configuration to storage, writing it to $SPTCFG_FILE"
  echo 'config (reset mode: restore original configuration):'
  echo "  -d, --default     load default configuration (and save it to $SPTCFG_FILE if -p/--persist is used)"
  echo '  -p, --persist     persist reset configuration to storage'
  echo '  -r, --restore     restore the original (or factory) contents of the configuration file'
  echo
  echo 'Options may be passed either apart (-a -b) or together (-ab), and anywhere on the command line, before and after a command'\''s arguments (if any).'
  echo 'Option arguments may be passed after the option (--opt arg) or together with it (--opt=arg or -oarg), including after other options (-mno=arg, but not -mnoarg).'
  echo 'If a double-dash (--) argument is present on the command line, all the following arguments, even dashed ones, will be taken as non-option args.'
  echo 'To view the valid options of any command at any time, pass -h or --help to it.'
  echo

  local example_name=$SPT_ENUM_EMPTY example_namepart example_number
  local exname_str exnpart_str exnum_str
  if ! $SPT_NOSCRIPTS; then
    while [[ $example_name == $SPT_ENUM_EMPTY ]]; do
      example_number=$(( RANDOM % SPT_ENUM_MAX ))
      example_name=${SPT_ENUM_SCRIPTS[$example_number]}
    done
    example_namepart=${example_name:0:2}
    exname_str=" (such as $example_name)" exnpart_str=" ($example_namepart)" exnum_str=" ($example_number)"
  fi

  echo "If no command is given, the usage message above is printed."
  echo "A script identifier is a name$exname_str, part of a name$exnpart_str, or a number$exnum_str that represents the script to act upon."
  echo "Use the \`enum\` command to see which numbers correspond to which scripts. Use \`enumgen\` to (re)create the mapping at $SPT_ENUM_FILE."
  echo "Enums generation is run automatically when $SPT_THIS notices the enums file is empty or does not exist."
  echo "With no script identifier argument, \`$SPT_THIS\` is assumed."
  echo "If a scriptname pattern is given to \`list\`, the list will contain only those filenames of which the given pattern is a substring."
  echo

  echo "If the keyword \`all\` (without quotes; case sensitive) is given to \`edit\`, \`del\` or \`view\`, the respective action is done to all script files."
  echo "As that word is case-sensitive, scriptnames such as \`All\` and \`ALL\` (as well as \`all.sh\`) can be used without conflict."
  echo "The scripts-manager script $SPT_THIS cannot be deleted with \`del\`. It will not delete itself, not even when the \`all\` keyword is used."
  echo "If only one argument is given to \`rename\`, that will be the new name of the $SPT_THIS script."
  echo "If the name given to \`link\` or to \`rename\` matches more than one file, a warning is printed and the user is prompted to select one of files."
  echo

  echo "The \`enum\` command shows the number mapped to a scriptfile, and vice-versa."
  echo "If one argument is given to it, \`enum\` shows the number or scriptfile associated with that argument."
  echo "If \`enum\` is given no arguments, it shows an enumerated list of all script files; with two or more arguments, it lists them and their mapped values."
  echo "If, among the arguments to \`enum\`, a script-number range is given, the scripts corresponding to the numbers within the range are printed."
  echo "A range is of the format A-B, where A and B (both inclusive) are script numbers."
  echo "A and B can be any value between 0 and $SPT_ENUM_MAX, in either order (B need not be greater than A)."
  echo

  echo "The \`config\` command queries and manages the script manager\`s configuration."
  echo "Configuration is read from and written to the file $SPTCFG_FILE."
  echo "Commandline options have overriding priority over configuration values."
  echo "The configuration file path can be passed via the environment variable SPTCFG_FILE before running $SPT_THIS."
  echo "Example: SPTCFG_FILE=~/.config/${SPT_THIS}rc $SPT_THIS edit -fg -L50 script.sh"
  echo

  echo "The \`config\` command has four modes of operation: list, get, set and reset."
  echo "Given -l/--list among \`config\`'s own options (i.e. before any \`--\`), it operates in \`list\` mode, whatever else is on the command line; otherwise the mode follows the number of non-option arguments, the words of a trailing command line included."
  echo "In \`list\` mode, \`config\` prints every valid configuration name and exits, without getting, setting or resetting anything."
  echo "With no non-option arguments at all, \`config\` operates in \`reset\` mode, resetting everything to its default value, or restoring the configuration file."
  echo "With one or more, \`config\` operates in \`set\` mode for those that contain an equal sign character, and in \`get\` mode for any others."
  echo "In \`get\` mode, \`config\` prints the value associated with a given configuration name (not sections; use -m/--match for them)."
  echo "In \`set\` mode, \`config\` temporarily or permanently changes one or more configuration values."
  echo "In \`set\` mode alone, \`config\` is enabled to run, under the modified configuration, any $SPT_THIS command line, including itself; the other modes change nothing for a command to run under, so they do not run one."
  echo "That command line is always introduced by a \`--\` argument: everything after the \`--\` is the command with its own options and arguments, and everything before it belongs to \`config\`."
  echo "The \`--\` is required even when the command line carries no flags of its own, so that a command name is never mistaken for a configuration name to get or set."
  wait
}

spt_help() { help_text $1 $2 | less; }

spt_getopt() {
  if [[ -z ${SPT_CMD_OPTMAP[-h]} ]]; then
    declare spec=$1 option opt_argtype opt_argname short long valid; shift
    declare -ga SPT_CMD_OPTS=() SPT_CMD_ARGS=()
    declare -gA SPT_CMD_OPTMAP=()
    declare -g  spt_argi=0 spt_argc spt_args_start spt_arg spt_opt spt_optarg

    IFS=';' read -a options <<< $spec
    for option in ${options[@]}; do
      IFS=':' read option opt_argtype opt_argname <<< $option
      short=${option:0:1} long=--${option:1}
      SPT_CMD_OPTMAP[-$short]=$short$opt_argtype
      SPT_CMD_OPTMAP[$long]=$short$opt_argtype
      valid+="-$short $long"; test "$opt_argname" && valid+=" $_"; valid+=', '
    done
    valid=${valid%, }; SPT_CMD_OPTMAP[-h]=h; SPT_CMD_OPTMAP[--help]=h
    unset spec option argtype short long

    help_valid() { echo "Valid options for $SPT_CMD: $valid" && exit 1; }
    check_opt()  { test "${SPT_CMD_OPTMAP[$1]}" || spt_die --up 2 "invalid option: $1 (valid options: $valid)"; }

    local args_only=false opt_gets_arg=false value; spt_argi=0
    for arg; do
      [[ $arg == --help ]] && help_valid
      if [[ $arg == -- ]]; then
        args_only=true opt_gets_arg=false spt_args_start=${#SPT_CMD_ARGS[@]}
      elif $args_only || [[ ${arg:0:1} != - ]]; then
        # the last argument on the command line is reserved for the command itself, but only while it still has none
        { $opt_gets_arg && { (( spt_argi != $#-1 )) || (( ${#SPT_CMD_ARGS[@]} )); }; } && SPT_CMD_OPTS+=($arg) opt_gets_arg=false || SPT_CMD_ARGS+=($arg)
      else
        opt_gets_arg=null
        if [[ ${arg:1:1} == - ]]; then
          if [[ $arg == *=* ]]; then
            IFS='=' read -r arg value <<< $arg
            SPT_CMD_OPTS+=($arg $value)
            opt_gets_arg=false # already got argument, don't do it again
          else
            SPT_CMD_OPTS+=($arg)
          fi
        else
          check_opt ${arg:0:2}; SPT_CMD_OPTS+=(${arg:0:2})
          if [[ ${arg:0:2} == -h ]]; then
            help_valid
          elif [[ ${#arg} -gt 2 ]]; then
            if [[ ${arg:2:1} == '=' ]]; then
              SPT_CMD_OPTS+=(${arg:3})
              opt_gets_arg=false
            elif [[ ${SPT_CMD_OPTMAP[${arg:0:2}]:1} ]]; then # req or opt: alone in the word, the option owns the whole tail
              SPT_CMD_OPTS+=(${arg:2}); arg=${arg:0:2}
            else
              local -i i
              for (( i=2; i<${#arg}; ++i )); do
                if [[ ${arg:$i:1} == 'h' ]]; then
                  help_valid
                elif [[ ${arg:$i:1} == '=' ]]; then # inside a cluster only an equal sign may open an argument
                  SPT_CMD_OPTS+=(${arg:$((i+1))}) opt_gets_arg=false && break
                else
                  check_opt -${arg:$i:1}
                  SPT_CMD_OPTS+=(-${arg:$i:1})
                fi
              done
              arg=-${arg:$((i-1)):1}
            fi
          fi
        fi

        if [[ $opt_gets_arg == null ]]; then
          check_opt $arg
          value=${SPT_CMD_OPTMAP[$arg]:1}
          [[ $value == req || $value == opt ]] && opt_gets_arg=true || opt_gets_arg=false
        fi
      fi
      ((++spt_argi))
    done
    spt_argc=$spt_argi; spt_argi=0
    [[ -z $spt_args_start ]] && spt_args_start=${#SPT_CMD_ARGS[@]} # no command line: every argument belongs to the command itself
    unset valid args_only prev_opt opt_gets_arg value
  fi

  spt_arg=${SPT_CMD_OPTS[$((spt_argi++))]}
  [[ -z $spt_arg || ${spt_arg:0:1} != - ]] && spt_arg=${SPT_CMD_ARGS[0]} && return 1
  spt_opt=${SPT_CMD_OPTMAP[$spt_arg]:0:1}
  local spt_optargtype=${SPT_CMD_OPTMAP[$spt_arg]:1}

  if [[ -n $spt_optargtype ]]; then
    spt_optarg=${SPT_CMD_OPTS[$spt_argi]}
    [[ ${spt_optarg:0:1} == - ]] && spt_optarg='' || ((++spt_argi))
    [[ $spt_optargtype == req && -z $spt_optarg ]] && spt_die --up "option $spt_arg requires an argument" || return 0
  fi
}

spt_sync() { exec rsync -cah -Pv --del --inplace --chmod F$SCRIPTS_BACKUP_DIR_PERMS $SCRIPTS_DIR/ $SCRIPTS_BUP; }

spt_perms() {
                            find $SCRIPTS_DIR -mindepth 1 ! -perm $SCRIPTS_DIR_PERMS        -exec chmod -v $SCRIPTS_DIR_PERMS        {} \;
  test -n "$SCRIPTS_BUP" && find $SCRIPTS_BUP -mindepth 1 ! -perm $SCRIPTS_BACKUP_DIR_PERMS -exec chmod -v $SCRIPTS_BACKUP_DIR_PERMS {} \;
}


# =========================== CONFIGURATION ===========================

sptcfg_checkname_section() { [[ "$1" =~ ^\[[a-z]+\]$ ]]; }
sptcfg_checkname_config()  { [[ "$1" =~ ^[a-z-]+$    ]]; }

check_sectionline() {
  if ! sptcfg_checkname_section "$config_line"; then
    spt_die "configuration file ($SPTCFG_FILE) is corrupt: section at line $line_number ($config_line) is invalid"
  fi
}

sptcfg_load() {
  confcheck_cache() {
    local checkcache_file=$HOME/.cache/spt-last-confcheck command=$1
    local -A checkcache
    local cached=false write_back=false
    local cfgpath

    test -e $checkcache_file || touch $_ 2>/dev/null || return 0 # do full check anyway in the impossibility of a cache
    if ! spt_is_file_empty $checkcache_file; then
      while read -r line; do
        [[ -z $line ]] && continue
        if [[ -z $cfgpath ]]; then
          cfgpath=$line
        else
          checkcache[$cfgpath]=$line # config mtime
          cfgpath=''
        fi
      done < $checkcache_file
      cached=true
    fi

    case $command in
      is-cached) $cached;;
      modified) [[ -z ${checkcache[$SPTCFG_FILE]} ]] || [[ ${SPTCFG_STAT[mtime]} != ${checkcache[$SPTCFG_FILE]} ]];;
      delete) unset checkcache\[$SPTCFG_FILE\]; write_back=true;;
      save) checkcache[$SPTCFG_FILE]=${SPTCFG_STAT[mtime]} write_back=true;;
    esac

    if $write_back; then
      truncate -s0 $checkcache_file
      for cfgpath in ${!checkcache[@]}; do
        echo $cfgpath
        echo ${checkcache[$cfgpath]}
      done >> $checkcache_file
    fi
  }

  needs_full_check() { ! confcheck_cache is-cached || confcheck_cache modified; }

  getenv() {
    local name=${value:4} i=0
    while [[ ${name:$i:1} =~ [a-zA-Z0-9_] ]]; do
      ((++i))
    done
    name=${name:0:$i}
    local -n valueref=$name
    test -n "$valueref" && printf -v value %s "$_${value:$((i+4))}" || spt_die --up "environment variable \$$name is not defined"
  }


  if [[ ! -e $SPTCFG_FILE ]]; then
    confcheck_cache delete; spt_die "Error: configuration file ($SPTCFG_FILE) does not exist."
  elif [[ ! -f $SPTCFG_FILE ]]; then
    confcheck_cache delete; spt_die "Error: $SPTCFG_FILE is not a file."
  elif (( SPTCFG_STAT[size] == 0 )); then
    confcheck_cache delete
    spt_warn 'Warning: %s is empty; use `%s config --restore` to restore it. Using default configuration...\n' $SPTCFG_FILE $SPT_THIS
    sptcfg_load_default
    return
  fi

  local section name value config_line line_number
  mapfile -t config_lines < <(sed -r 's/\s*#.+$//;/^$/d' $SPTCFG_FILE) # remove comments and empty lines
  local config_line="${config_lines[0]}" line_number=1

  check_sectionline && section=${config_line:1:-1}

  for (( i=1; i<${#config_lines[@]}; ++i )); do
    (( ++line_number ))
    config_line="${config_lines[$i]}"
    [[ ${config_line:0:1} == '[' ]] && check_sectionline && section=${config_line:1:-1} && continue
    IFS='=' read -r name value <<< "$config_line"
    sptcfg_checkname_config "$name" || spt_die "invalid configuration name ($name) on line $line_number of configuration file ($SPTCFG_FILE)"
    [[ "$value" == *~/*  ]] && value=$(sed -r "s|^~/|$HOME/|" <<< $value)
    [[ "$value" =~ ^env: ]] && getenv
    SPTCFG[$section/$name]="$value" SPTCFG_NAMES+=($section/$name)
  done

  needs_full_check && sptcfg_check && confcheck_cache save
}

sptcfg_load_default() {
  SPTCFG[path/spts-origdir]=/app/scripts
  SPTCFG[path/spts-bkupdir]=/app/script-backups
  SPTCFG[path/enum-mapping]=/etc/spt.enum

  SPTCFG[perms/spts-origdir]=755
  SPTCFG[perms/spts-bkupdir]=600
  SPTCFG[perms/enum-mapping]=600

  SPTCFG[edit/mode]=cli
  SPTCFG[edit/selected-match]=all
  SPTCFG[edit/scriptname-sep]=dash
  SPTCFG[edit/autoshebang]=bash

  SPTCFG[editor/cli]=vim
  SPTCFG[editor/gui]=
  SPTCFG[editor/argfmt-cli]=%l\ %s
  SPTCFG[editor/argfmt-gui]=%s
  SPTCFG[editor/lnflag-cli]=+
  SPTCFG[editor/lnflag-gui]=
  SPTCFG[editor/wait-on-gui]=false

  SPTCFG[del/confirm]=all
  SPTCFG[view/mode]=pagedcolor

  SPTCFG[list/dir]=scripts
  SPTCFG[list/sort]=name

  SPTCFG[link/force]=false
  SPTCFG[link/symbolic]=true
  SPTCFG[link/symchain]=true
}

sptcfg_store() {
  sptcfg_check

  local section name value svalue config_line line_number
  mapfile -t config_lines < $SPTCFG_FILE # including comments and empty lines, so that we can write them back
  local config_line line_number=1 line_char

  for (( i=0; i<${#config_lines[@]}; ++i )); do
    (( ++line_number ))
    config_line="${config_lines[$i]}"
    line_char=${config_line:0:1}

    if [[ -n "$config_line" && $line_char != '#' ]]; then
      if [[ $line_char == '[' ]]; then
        check_sectionline
        section=${config_line:1:-1}
      else
        IFS='=' read -r name value <<< "$config_line"
        sptcfg_checkname_config "$name" || spt_die "invalid configuration name ($name) on line $line_number of configuration file ($SPTCFG_FILE)"
	svalue=${value%%#*}; svalue=${svalue%"${svalue##*[![:space:]]}"} # stripped value
        [[ $svalue != ${SPTCFG[$section/$name]} ]] && config_line="${config_line/=$svalue/=${SPTCFG[$section/$name]}}"
      fi
    fi

    echo "$config_line"
  done > $SPTCFG_FILE
}

