spt_config() {
  local arg argc i name endopts=false listmode=false full=false
  # One pass settles the mode before a single option is parsed. -l/--list is a
  # mode selector rather than any one mode's flag, so it wins wherever it shows
  # up; failing that, the count of non-option arguments tells reset from
  # get/set. Anything after the -- belongs to the trailing command, so the -l
  # scan stops there -- `config x=1 -- link -l help help.sh` passes -l to link.
  # argc still counts the words after the --, as it always has.
  for (( i=1, argc=0; i<=$#; ++i )); do
    arg=${@:$i:1}
    if [[ ${arg:0:1} == - ]]; then
      if [[ $arg == -- ]]; then
        endopts=true
      elif ! $endopts && [[ $arg == --list || ( $arg != --* && $arg == -*l* ) ]]; then
        listmode=true
      fi
    else
      ((++argc))
    fi
  done

  # List mode: neither of the other two runs, and no command line is executed --
  # nothing was configured for one to run under.
  if $listmode; then
    while spt_getopt 'llist;Ffull' $@; do
      case $spt_opt in
        l) ;; # settled by the pass above; here so that -l counts as a valid option
        F) full=true;;
      esac
    done

    for name in ${SPTCFG_NAMES[@]}; do
      $full && echo "$name=${SPTCFG[$name]}" || echo $name
    done
    return 0
  fi

  if (( $argc == 0 )); then
    # state modes:
    # default=true, persist=false: restore default configuration in memory only
    # default=true, persist=true: restore default configuration both in memory and in the file
    # default=false (restore mode): factory-reset configuration file, then reload it
    local default=true persist=false

    while spt_getopt 'ddefault;ppersist;rrestore' $@; do
      case $spt_opt in
        d) default=true persist=false;;
        p) default=true persist=true;;
        r) default=false;;
      esac
    done

    if $default; then
      sptcfg_load_default
      $persist && sptcfg_store
    else
      sptcfg_restore
      sptcfg_load
    fi
  else
    matchname() {
      matches=()
      for n in $SPTCFG_VALID; do [[ $n == *$name* ]] && matches+=($n); done
      [[ ${#matches[@]} -gt 0 ]]
    }

    checkname() {
      if { $match && [[ -n $name ]] && ! matchname; } || { ! $match && [[ ! "$SPTCFG_VALID" =~ .*^$name$.* ]]; }; then
        local msg="$name: invalid configuration name" matchmsg="use -m or --match for section names" is_sectionlike=false name_regex='[^ /]+'
        [[ $name =~ ^$name_regex/?$ || ! $name =~ ^$name_regex/$name_regex$ ]] && ! $match && is_sectionlike=true
        if $fail || (( argc == 1 )); then
          $is_sectionlike && spt_die --up "$msg; $matchmsg" || spt_die --up "$msg; use config -l (or --list) to view all the valid names"
        else
          $is_sectionlike && matchmsg=" ($matchmsg)" || matchmsg=''
          ( spt_die --up "$msg$matchmsg; ignoring..." )
          return 1
        fi
      elif ! $match ; then
        matches=($name)
      fi
    }

    print_value() {
      name=$spt_arg
      checkname || return 1
      for name in ${matches[@]}; do
        value=${SPTCFG[$name]}
        $full && echo "$name=$value" || echo $value
      done
    }

    set_value() {
      name=$1 value=$2
      checkname || return 1
      for name in ${matches[@]}; do
        SPTCFG[$name]=$value
        ((++setcnt))
      done
    }


    local value setcnt=0 match=false fail=false persist=false; local -a matches
    while spt_getopt 'mmatch;ffail;Ffull;ppersist' $@; do
      case $spt_opt in
        m) match=true;;
        f) fail=true;;
        F) full=true;;
        p) persist=true;;
      esac
    done

    local SPTCFG_VALID="$(tr ' ' '\n' <<< ${SPTCFG_NAMES[*]})"
    spt_argi=1 # reused here to walk SPT_CMD_ARGS, which spt_getopt does not iterate itself

    while [[ -n $spt_arg ]]; do
      if [[ $spt_arg == *=* ]]; then
        set_value ${spt_arg/=*/} ${spt_arg/*=/}
      else
        print_value
      fi
      (( spt_argi >= spt_args_start )) && break
      spt_arg=${SPT_CMD_ARGS[$((spt_argi++))]}
    done

    if (( setcnt > 0 )); then
      if $persist; then
        sptcfg_store
      else
        sptcfg_check
      fi
    fi

    # A trailing command line belongs to `set` mode alone: it is there so the
    # command runs under the configuration this call changed, and there is
    # nothing for it to run under when nothing was set.
    if (( setcnt > 0 )) && test "${SPT_CMD_ARGS[spt_argi]}"; then
      sptcfg_check
      unset SCRIPTS_DIR SPT_CMD_OPTMAP\[-h\]
      spt_main ${SPT_CMD_ARGS[@]:$spt_argi}
    fi
  fi
}

# =========================== CONFIGURATION CHECKS ===========================

sptcfg_invalid() { spt_die "Error (invalid configuration): $config ($value): $1)"; }

sptcfg_check_path() {
  local config=path/spts-$1dir
  local value=${SPTCFG[$config]}
  if   [[ ! -e $value ]]; then
    sptcfg_invalid 'path does not exist'
  elif [[ ! -d $value ]]; then
    sptcfg_invalid 'not a directory'
  elif [[ ! -x $value ]]; then
    sptcfg_invalid 'directory is not accessible'
  elif [[ ! -r $value || ! -w $value ]]; then
    sptcfg_invalid 'cannot read and/or write files in that directory'
  fi
}

sptcfg_check_enummap() {
  local config=path/enum-mapping value=${SPTCFG[path/enum-mapping]}
  if [[ -e $value ]]; then # it's okay if it doesn't exist; we'll create it later
    if [[ ! -f $value ]]; then
      sptcfg_invalid 'not a regular file'
    elif [[ ! -r $value ]]; then
      sptcfg_invalid 'cannot read file (insufficient permissions)'
    elif [[ ! -w $value ]]; then
      sptcfg_invalid 'cannot write to file (insufficient permissions)'
    fi
  fi
}

sptcfg_check_perms() {
  local config=perms/$1 value=${SPTCFG[perms/$1]}
  local IFS=,
  for perms in $value; do
    [[ ! $perms =~ ^(([ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=]?[0-7]{3}))$ ]] && sptcfg_invalid 'invalid permission specification; see chmod(1) for more information'
  done
}

sptcfg_check_others() {
  check_valueset() {
    format_valid_values() {
        local quote='`'
        printf "$quote%s$quote" $valid_values_set
        for (( i=1; i<$((${#valid_values_set[@]}-1)); ++i )); do printf ", $quote%s$quote" ${valid_values_set[$i]}; done
        printf " and $quote%s$quote" ${valid_values_set[$i]}
    }
    config_specific_checks() {
      case $config in
        edit/scriptname-sep) [[ $value =~ ^[-_.:]$ ]] && sptcfg_invalid "use the characters' names ($(format_valid_values)), not their literal representation";;
      esac
    }

    local config=$1 value=${SPTCFG[$1]} valid=false
    IFS=' ' read -a valid_values_set <<< $2
    config_specific_checks
    for vv in ${valid_values_set[@]}; do [[ $value == $vv ]] && valid=true && break; done
    $valid || sptcfg_invalid "invalid value (valid ones are $(format_valid_values)"
  }

  check_exec() {
    IFS=' ' local config=$1 value=${SPTCFG[$1]} empty_ok=false # IFS is set for trimming leading spaces, if any, which are not of interest here
    [[ $2 == empty_ok ]] && empty_ok=true
    if [[ -n $value ]]; then
      [[ -f $value ]] && sptcfg_invalid 'give it a program name, not a path'
      command -v $value >/dev/null || sptcfg_invalid 'no executable program found; check PATH, file permissions, and the configured name'
    elif ! $empty_ok; then
      sptcfg_invalid 'should not be empty (specify a program name)'
    fi
  }

  check_boolean() { local config=$1 value=${SPTCFG[$1]}; [[ ! $value =~ ^(true|false)$ ]] && sptcfg_invalid 'invalid boolean value (must be either true or false)'; }

  check_argfmt() {
    local config=$1 value=${SPTCFG[$1]}
    local fmtspecs=none # none, scriptname_absent, scriptname_present, repeated
    local char

    # state machine
    for (( i=0; i<${#value}; ++i )); do
      char=${value:$i:1}
      if [[ $char == % ]]; then
        char=${value:$((++i)):1}
        case $char in
          s|l|%)
            case $fmtspecs in
              none)               [[ $char == s ]] && fmtspecs=scriptname_present || fmtspecs=scriptname_absent;;
              scriptname_absent)  [[ $char == s ]] && fmtspecs=scriptname_present || fmtspecs=repeated;;
              scriptname_present) [[ $char == l ]] || fmtspecs=repeated;; # once in the 'repeated' state, there's no way out, for error-logging purposes
              repeated) break;;
            esac
            ;;
          *) sptcfg_invalid 'unknown format specifier (use %s, %l or %%)';;
        esac
      fi
    done

    case $fmtspecs in
      none)              sptcfg_invalid 'no specifier used in format string (there must be at least %s, the scriptname specifier)';;
      repeated)          sptcfg_invalid '%s and %l should each be used only once in the format string';;
      scriptname_absent) sptcfg_invalid 'scriptname format specifier %s is absent from the format string ';;
    esac
  }

  local -a which=($1)

  if [[ ! -v CHECKCONF_MAPPING ]]; then
    declare -gA CHECKCONF_MAPPING=(
      [edit/mode]="valueset.'cli gui'"
      [edit/selected-match]="valueset.'all first last'"
      [edit/scriptname-sep]="valueset.'dash underline dot colon'"

      [edit/autoshebang]=exec.empty_ok [editor/cli]=exec. [editor/gui]=exec.empty_ok

      [editor/argfmt-cli]=argfmt. [editor/argfmt-gui]=argfmt. [editor/wait-on-gui]=boolean.

      [del/confirm]="valueset.'all once no'"
      [view/mode]="valueset.'pagedcolor paged color simple'"
      [list/dir]="valueset.'scripts backup both'"
      [list/sort]="valueset.'name date-abs date-rel'"

      [link/force]=boolean. [link/symbolic]=boolean. [link/symchain]=boolean.
    )
  fi

  [[ $1 == all ]] && which=(${!CHECKCONF_MAPPING[@]})

  for conf in ${which[@]}; do eval "check_${CHECKCONF_MAPPING[$conf]/./ $conf }"; done
}

sptcfg_check() {
  sptcfg_check_path orig
  sptcfg_check_path bkup
  sptcfg_check_enummap

  sptcfg_check_perms spts-origdir
  sptcfg_check_perms spts-bkupdir
  sptcfg_check_perms enum-mapping

  sptcfg_check_others all

  return 0
}


# =========================== ENUMERATION ===========================

spt_enum_register() {
  local new_script=$1
  local -i new_number=$SPT_ENUM_NES

  if (( new_number == SPT_ENUM_MAX )); then
    local -i number; SPT_ENUM_MAX+=SPT_ENUM_INC
    for (( number=SPT_ENUM_MAX-SPT_ENUM_INC; number<SPT_ENUM_MAX; ++number )); do
      printf '%d %s\n' $number $SPT_ENUM_EMPTY
    done >> $SPT_ENUM_FILE
    unset number
  fi

  SPT_ENUM_SCRIPTS[$new_number]=$new_script
  SPT_ENUM_NUMBERS[$new_script]=$new_number
  sed -i "$((new_number+1)) s/\\$SPT_ENUM_EMPTY$/$new_script/" $SPT_ENUM_FILE
}

spt_enumdb_generate() {
  local errorflag=$1 errormsg=$2

  if [[ -n $errorflag ]]; then $SPT_NOSCRIPTS && return 1 || echo $SPT_ENUM_FILE $errormsg >&2
  elif $SPT_NOSCRIPTS;    then spt_die "failed to generate enums file: no script in $SCRIPTS_DIR"; fi

  SPT_ENUM_MAX=$SPT_ENUM_INC
  while (( SPT_ENUM_MAX <= SPT_COUNT )); do ((SPT_ENUM_MAX+=$SPT_ENUM_INC)); done

  local number script
  for (( number=0; number<SPT_COUNT; ++number )); do
    script=${SPT_SCRIPTNAMES[$number]}
    SPT_ENUM_SCRIPTS[$number]=$script
    SPT_ENUM_NUMBERS[$script]=$number
  done
  SPT_ENUM_NES=$number
  for (( ; number < SPT_ENUM_MAX; ++number )); do
    SPT_ENUM_SCRIPTS[$number]=$SPT_ENUM_EMPTY
  done

  move_sptname() {
    local linknum=$1 linkname=${SPT_ENUM_SCRIPTS[$1]} targetnum=$2
    ((linknum==targetnum)) && return
    SPT_ENUM_SCRIPTS[$targetnum]+=" $linkname"
    unset SPT_ENUM_SCRIPTS\[$linknum\]
    SPT_ENUM_NUMBERS[$linkname]=$targetnum
  }

  local -a links=($(find $SCRIPTS_DIR -mindepth 1 \( -type l -o -type f -links +1 \)))
  if [[ ${#links[@]} -gt 0 ]]; then
    for script in $(ls -rt ${links[@]}); do
      number=${SPT_ENUM_NUMBERS[$(basename $script)]}
      if test -L $script; then
        script=$(readlink $_)
        [[ $(dirname $script) =~ ^(\.|$SCRIPTS_DIR)$ ]] || continue
      else
        stat $script
        test $script != ${SPT_INODES[${STAT[inode]}]} && script=$_ || continue
      fi
      move_sptname $number ${SPT_ENUM_NUMBERS[$script]}
    done

    declare number=0 new_number=0
    while true; do
      script=${SPT_ENUM_SCRIPTS[$((number++))]}
      test -z $script && continue
      SPT_ENUM_SCRIPTS[$((new_number++))]=$script
      if [[ $script == $SPT_ENUM_EMPTY ]]; then
        for (( number=new_number; number<SPT_ENUM_MAX; ++number )); do test ${SPT_ENUM_SCRIPTS[$number]} != $SPT_ENUM_EMPTY && SPT_ENUM_SCRIPTS[$number]=$_; done
        break
      fi
    done
    SPT_ENUM_NES=$new_number
    (( SPT_ENUM_NES < SPT_ENUM_MAX - SPT_ENUM_INC )) && ((SPT_ENUM_MAX-=SPT_ENUM_INC))
  fi

  for (( number=0; number<SPT_ENUM_MAX; ++number )); do
    script=${SPT_ENUM_SCRIPTS[$number]}
    printf "%d %s\n" $number $script
    if [[ $script != $SPT_ENUM_EMPTY ]]; then
      ((++SPT_ENUM_CNT))
    elif [[ $script == $SPT_THIS* ]]; then
      SPT_THIS_NUMBER=$number
    fi
  done > $SPT_ENUM_FILE
}

spt_enumdb_load() {
  while IFS=' ' read -r number script; do
    if (( number != SPT_ENUM_MAX )); then
      if [[ $1 == regenerated ]]; then
        printf '' > $SPT_ENUM_FILE
        spt_debug "$SPT_ENUM_FILE remained corrupted and has been cleared up; check spt_enumdb_generate for bugs."
      else
        spt_error "$SPT_ENUM_FILE is corrupted; regenerating and reloading..."
      fi
      spt_enumdb_generate
      spt_enumdb_load regenerated
      return $?
    fi

    SPT_ENUM_SCRIPTS[$number]=$script
    [[ $script == $SPT_THIS* ]] && SPT_THIS_NUMBER=$number
    if [[ -z ${SPT_ENUM_NUMBERS[$script]} ]]; then
      if [[ $script == *' '* ]]; then
        IFS=' ' read -ra scripts <<< $script
        for script in ${scripts[@]}; do SPT_ENUM_NUMBERS[$script]=$number; done
      else
        SPT_ENUM_NUMBERS[$script]=$number
      fi
    fi
    ((++SPT_ENUM_MAX))
    [[ $script != $SPT_ENUM_EMPTY ]] && ((++SPT_ENUM_CNT))
  done < $SPT_ENUM_FILE

  SPT_ENUM_NES=${SPT_ENUM_NUMBERS[$SPT_ENUM_EMPTY]}
  [[ -z $SPT_ENUM_NES ]] && SPT_ENUM_NES=$SPT_ENUM_MAX
}

spt_enumdb_rename() {
  local number=$1 oldname=$2 newname=$3
  [[ -z $3 ]] && oldname=${SPT_ENUM_SCRIPTS[$number]} newname=$2
  SPT_ENUM_SCRIPTS[$number]="$newname"
  unset SPT_ENUM_NUMBERS\[$oldname\]
  sed -ri "$((number+1)) s|$oldname|$newname|" $SPT_ENUM_FILE
}

spt_enumdb_clear() { spt_enumdb_rename $1 "$SPT_ENUM_EMPTY"; }

checkfor() {
  local -n check=SPT_IS$1 last=SPT_IS$1_LAST
  local value=$2 regex="^$3[0-9]+$"
  if [[ $last != $value ]]; then
    [[ $value =~ $regex ]] && check=true || check=false
    last=$value
  fi
  $check
}

spt_isnum()   { checkfor NUM   $1; }
spt_isrange() { checkfor RANGE $1 '[0-9]+-'; }

spt_firstlink() {
  stat $1 2>/dev/null
  [[ -n $SPT_FIRSTLINK ]] && SPT_FIRSTLINK=''
  (( ${STAT[nlink]} == 1 )) && return 1
  SPT_FIRSTLINK=${SPT_INODES[${STAT[inode]}]}
  [[ $SPT_FIRSTLINK == $(basename $1) ]] && SPT_FIRSTLINK='' && return 1
  return 0
}

spt_enum_get() {
  local key=$1 outvar=$2 array_output=false value null
  [[ $1 == -a   ]] && array_output=true key=$2 outvar=$3
  [[ -z $outvar ]] && outvar=null

  case $outvar in outvar|key|start|end) spt_debug "error: outvar ($outvar) should not be set to any of this function's locals";; esac
  scripts=() numbers=()

  if spt_isnum $key; then
    if (( key >= 0 && key <= SPT_ENUM_MAX )); then
      value=${SPT_ENUM_SCRIPTS[$key]}
      $array_output && scripts+=($value) || IFS=' ' printf -v $outvar %s $value
      # IFS=' ' is used above so that only the first scriptname is selected if key has symbolic links
    else
      spt_error "$key: invalid number (must be between 0 and $SPT_ENUM_MAX)"
      return 1
    fi
  elif [[ $key == $SPT_ENUM_EMPTY ]]; then
    $array_output && scripts+=($SPT_ENUM_NES) || printf -v $outvar %d $SPT_ENUM_NES
  elif [[ -n ${SPT_ENUM_NUMBERS[$key]} ]]; then
    value=${SPT_ENUM_NUMBERS[$key]}
    $array_output && numbers+=($value) || printf -v $outvar %d $value
  else # unconditional array output
    if spt_isrange $key; then
      local start end; IFS=- read start end <<<$key
      if (( start >= 0 && end <= SPT_ENUM_MAX )); then
        printf -v $outvar %s ${SPT_ENUM_SCRIPTS[$start]}
        IFS=' ' numbers=($(eval "echo {$start..$end}"))
      else
        spt_error "$key: invalid range (must be between 0 and $SPT_ENUM_MAX)"
        return 1
      fi
    else
      local IFS=' '
      scripts=($(cd $SCRIPTS_DIR && echo *$key*))
      if (( ${#scripts[@]} == 0 )); then
        spt_error --up "$key: no such script"
        return 1
      fi
    fi
  fi
}

spt_enum() {
  (( SPT_ENUM_CNT == 0 )) && spt_die 'No enums to list.'

  print_script() {
    local script=$1 number=$2 print_script_only=false empty=false esc end='\n'

    [[ -z $number ]] && print_script_only=true
    if [[ $script == *$SPT_ENUM_EMPTY ]]; then
      empty=true
      [[ $number == $SPT_ENUM_NES || $script == '->'* ]] && script='[next empty slot]' empty=false || script='[empty]'
      esc=$yellow
    elif [[ $script == $SPT_THIS* ]]; then
      esc=$green
    fi
    [[ -n $esc ]] && end="$reset\n"

    if $empty && ! $print_script_only; then
      local last_number=$number
      while (( last_number < SPT_ENUM_MAX )); do
        [[ ${SPT_ENUM_SCRIPTS[$((last_number+1))]} == $SPT_ENUM_EMPTY ]] || break
        ((++last_number))
      done
      if (( last_number - number >= 1 )); then
        local sep='–';
        (( last_number - number == 1 )) && sep='&'
        printf "$esc${numfmt:0:-2} $sep $numfmt%s$end" $number $last_number "$script"
        k=$last_number
        return
      fi
    fi

    printf "$esc$numfmt%s$end" $number "$script" # numfmt will be empty when number is empty (print_script_only is true)
    ((++k))
  }

  print_number() {
    local number=$1 script=$2 sptfile=$SCRIPTS_DIR/$2 fmt='%s: '

    if [[ -z $script ]]; then
      unset fmt
    elif test -L $sptfile; then
      script+=" (symbolic link to $(readlink $sptfile))"
    elif spt_firstlink $_; then
      script+=" (hard link to $SPT_FIRSTLINK)"
    fi

    case $number in
      $SPT_THIS_NUMBER) printf "$green$fmt%d$reset\n" $script $number;;
      [0-9]*) printf "$fmt%d\n" $script $number;;
    esac
  }

  print_numbers() { for key; do print_number ${SPT_ENUM_NUMBERS[$key]} $key; done; }

  print_value() {
    local key=$1 print_value_only=false val
    [[ $key == --only && -n $2 ]] && print_value_only=true key=$2

    local -a scripts numbers
    spt_enum_get $key val || return 1

    [[ $key == $SPT_ENUM_NES ]] && val="->$SPT_ENUM_EMPTY"
    $print_value_only && unset key

    if (( ${#scripts[@]} > 1 )); then
      for key in ${scripts[@]}; do
        print_number ${SPT_ENUM_NUMBERS[$key]} $key
      done
    elif $SPT_ISNUM; then
      print_script $val $key
      return # avoid incrementing k below as print_script already does it
    else
      print_number "$val" "$key"
    fi

    ((++k))
  }


  local -a keys scripts numbers
  local k=0 keycount=$# num
  local green='\e[32m' yellow='\e[33m' reset='\e[0m' numfmt=%d # numfmt is used by print_script

  $istty_out || unset green yellow reset # do not use colors when stdout is not a terminal

  if (( keycount == 0 )); then
    numfmt="%${#SPT_ENUM_MAX}d. "
    while (( k < SPT_ENUM_MAX )); do
      print_script ${SPT_ENUM_SCRIPTS[$k]} $k
    done
  elif (( keycount == 1 )) && ! spt_isrange $1; then
    unset numfmt
    print_value --only $1
  else
    keys=($@)
    for key; do
      spt_isrange $key && spt_enum_get $key && keys+=(${numbers[@]}) && continue
      keys+=($key)
    done
    keycount=${#keys[@]}

    local -i maxdigits=1 numdigits
    for key in ${keys[@]}; do
      if spt_isnum $key; then
        numdigits=${#key}
        (( numdigits > maxdigits )) && numfmt=%${numdigits}d maxdigits=numdigits;
      fi
    done
    numfmt+='. '; unset key maxdigits numdigits

    while (( k < keycount )); do
      print_value ${keys[$k]}
    done
  fi
}


# =========================== EDIT AND DELETE ===========================

get_filename() {
  [[ -z $1 ]] && local sptf=$sptfile || local sptf=$1
  if [[ -e $SCRIPTS_DIR/$sptf ]]; then
    sptpaths=($sptf)
  else
    local -a scripts numbers
    spt_enum_get -a $sptf || return 1
    if [[ ${scripts[0]} == $SPT_ENUM_EMPTY ]]; then
      spt_isnum $sptf && spt_die "no script with enumeration $sptf yet" || spt_die "$sptf: no script found"
    fi
    sptpaths=(${scripts[@]} ${numbers[@]})
  fi
}

editfile() {
  local -a sptpaths; local sptpath sptcopy end=false waiting self_edit new_file selection
  [[ -z $sptfile ]] && sptfile=$1

  if test ! -e $SCRIPTS_DIR/$sptfile && [[ $sptfile != $SPT_THIS ]]; then
    get_filename &>/dev/null
  elif [[ $sptfile != $SPT_THIS ]]; then
    sptpaths=($sptfile)
  else
    sptpaths=($SPT_PATH)
  fi

  if [[ ${#sptpaths[@]} -eq 0 ]]; then
    sptpaths=($SCRIPTS_DIR/$sptfile)
    new_file=true
  else
    new_file=false
    if [[ ${#sptpaths[@]} -gt 1 && $selected_match != all ]]; then
      [[ $selected_match == first ]] && selection=$sptpaths || selection=${sptpaths[-1]}
      sptpaths=($selection)
    fi
  fi

  for sptpath in ${sptpaths[@]}; do
    sptfile=$(basename $sptpath)
    sptcopy=/tmp/$sptfile
    self_edit=false

    if ! $new_file; then
      if [[ $sptfile == $SPT_THIS ]]; then
        cp -a $sptpath $sptcopy
        sptpath=$sptcopy
        sptcopy=$SPT_PATH
        self_edit=true
      else
        test ! -e $sptcopy && cp -a $sptpath $_ # do not copy if it was already there (which might be due to a crash)
      fi
    else
      if [[ "$sptfile" == *' '* ]]; then
        spt_warn "\"$sptfile\" contains spaces, which is not allowed in scriptnames; $SPT_THIS will replace them with dashes."
        sptfile=${sptfile/ /-}
        spt_warn "New name: $sptfile"
      fi

      if test "$autoshebang"; then
        make_shebang || continue
        if test "$autoshebang"; then
          printf %s "$_" > $sptcopy
          sptpath=$sptcopy
          sptcopy=/tmp/$sptfile.tmp # for when $istty_in is false
        fi
      fi
    fi

    if $istty_in; then
      eval "$editor $(printf $editor_argfmt $editor_args)" || end=true

      if $guiwait && ! $end; then
        waiting=true; trap 'waiting=false' INT
        while $waiting && pgrep ${SPTCFG[editor/gui]} >/dev/null; do sleep 1; done
        trap '' INT
        kill $(pgrep ${SPTCFG[editor/gui]}) 2>/dev/null && end=true
      fi
    elif [[ -n $line ]]; then
      local -i at=$line_num
      # an autoinserted shebang is not the user's own content, so it does not count towards the line number
      $new_file && test "$autoshebang" && at+=$(printf %s "$_" | grep -c '')
      cat > $sptcopy.stdin
      head -n $((at-1)) $sptpath > $sptcopy.before # the lines above the insertion point
      tail -n +$at      $sptpath > $sptcopy.after  # and the ones from it onwards, which stdin goes before
      cat $sptcopy.{before,stdin,after} > $sptpath
      rm  $sptcopy.*
    else
      cat >> $sptpath
    fi

    if $new_file && test "$autoshebang"; then
      if [[ -z "$(cat $sptpath | tail -n+2)" ]]; then
        unlink $sptpath
      else
        mv $sptpath $SCRIPTS_DIR
        sptpath=$SCRIPTS_DIR/$sptfile
      fi
    fi

    if { $new_file && [[ -e $sptpath ]]; } || { ! $new_file && hashcmp -n $sptpath $sptcopy; }; then
      if [[ -v SCRIPTS_BUP ]]; then
        [[ $sptfile != $SPT_THIS || $SPT_PATH == $SCRIPTS_DIR* ]] && install -m $SCRIPTS_BACKUP_DIR_PERMS $sptpath $SCRIPTS_BUP/$sptfile
      else
        spt_warn "\$SCRIPTS_BUP (scripts backup directory) is not defined; the $sptfile script will not be backed up."
      fi
      if $self_edit; then
        mv $sptpath $sptcopy
        continue
      fi
      if $new_file; then
        spt_enum_register $sptfile
        chmod $SCRIPTS_DIR_PERMS $sptpath
      fi
    elif $self_edit; then
      sptcopy=$sptpath
    fi

    if ! $new_file; then unlink $sptcopy; fi # use if-fi to avoid exiting with unlink's exit code
    $end && return 1
  done
  return 0
}

spt_edit() {
  make_shebang() {
    IFS=' ' local -a args=($autoshebang); autoshebang=''
    local interpreter=${args[0]} env

    if [[ $interpreter == env ]]; then
      env=$(which env 2>/dev/null) || spt_error "error: env(1) not found in this system; disabling autoshebang..." && return 1
      interpreter=${args[1]}
      [[ -z "$interpreter" ]] && spt_error "error: env(1) needs arguments; disabling autoshebang..." >&2 && return 1
      args=(${args[@]:2})
    else
      args=(${args[@]:1})
      local intpath=$(which $interpreter 2>/dev/null) # local var for checking only
      [[ -z $intpath ]] && spt_error "$interpreter: invalid interpreter for autoinserted shebang (it either does not exist or is not executable); ignoring..." && return 1
      interpreter=$intpath
    fi

    local shebang_line='#!'
    test $env && shebang_line+="$_ "
    shebang_line+=$interpreter
    test ${args[*]} && shebang_line+=" $_"

    printf -v autoshebang '%s\n\n' $shebang_line
  }


  local editmode=${SPTCFG[edit/mode]} autoshebang=${SPTCFG[edit/autoshebang]} editor using_cli_editor sptfile
  local editor_argfmt editor_args guiwait selected_match=${SPTCFG[edit/selected-match]} line line_flag line_num


  while spt_getopt 'ccli;ggui;ffirst;llast;aall;Lline:opt:LINE;bbang:req:ARGS;Bnobang' $@; do
    case $spt_opt in
      c) editmode=cli;;
      g) editmode=gui;;
      f) selected_match=first;;
      l) selected_match=last;;
      a) selected_match=all;;
      L) if spt_isnum $spt_optarg; then line_num=$_; else line_num=1; fi;;
      b) autoshebang=$spt_optarg;;
      B) autoshebang='';;
    esac
  done
  [[ $editmode == cli ]] && using_cli_editor=true || using_cli_editor=false


  if [[ -n $line_num ]]; then
    $using_cli_editor && line_flag=${SPTCFG[editor/lnflag-cli]} || line_flag=${SPTCFG[editor/lnflag-gui]}
    line=$line_flag$line_num
  fi
  if ! $using_cli_editor && [[ -z ${SPTCFG[editor/gui]} ]]; then
    spt_warn "GUI editing not available; switching to CLI with ${SPTCFG[editor/cli]}..."
    using_cli_editor=true
  fi

  if $using_cli_editor; then
    editor=$(which ${SPTCFG[editor/cli]})
    editor_argfmt=${SPTCFG[editor/argfmt-cli]}
    guiwait=false
  else
    editor=$(which ${SPTCFG[editor/gui]})
    editor_argfmt=${SPTCFG[editor/argfmt-gui]}
    guiwait=${SPTCFG[editor/wait-on-gui]}
    trap "pkill ${SPTCFG[editor/gui]}" EXIT
  fi

  if [[ $line ]]; then
    editor_args=${editor_argfmt/\%l/$line}
    editor_args=${editor_args/\%s/\$sptpath}
    editor_argfmt=${editor_argfmt/\%l/%c%d}
  else
    editor_argfmt=${editor_argfmt/\%l/}
    editor_args=${editor_argfmt/\%s/\$sptpath}
  fi


  if [[ -z $spt_arg ]]; then
    editfile $SPT_THIS || return 1
  else
    cd $SCRIPTS_DIR || return 1
    if [[ $spt_arg == all ]]; then
      for sptfile in $(find $SCRIPTS_DIR -type f -printf '%f\n'); do editfile || return 1; done
    else
      for sptfile in ${SPT_CMD_ARGS[@]}; do editfile || return 1; done
    fi
  fi
}

spt_del() {
  local -a sptpaths
  local confirm=${SPTCFG[del/confirm]} confirm_all=false ANS status=0

  while spt_getopt 'yyes;cconfirm;oask-once' $@; do
    case $spt_opt in
      y) confirm=no;;
      c) confirm=all;;
      o) confirm=once;;
    esac
  done

  [[ $confirm == all ]] && confirm_all=true


  local red green blue endc endc2
  $istty_out && green=$'\e[32m' blue=$'\e[34m' endc=$'\e[0m'
  $istty_err && red=$'\e[31m' endc2=$'\e[0m'

  info()    { echo -e "$blue$1$endc"; }
  success() { echo -e "$green$1$endc"; }
  error()   { echo -e "$red$1$endc2" 2>/dev/null; }


  if [[ $spt_arg == all ]]; then
    read -rp 'Delete all scripts? type YES to confirm: ' ANS; echo
    [[ $ANS != YES ]] && info 'Deletion canceled.' && return 1
    [[ -e $SCRIPTS_DIR/$SPT_THIS ]] && mv $SPT_PATH /tmp
    if rm -fv $SCRIPTS_DIR/*; then
      rm -f $SCRIPTS_BUP/* $SPT_ENUM_FILE
      success "All scripts have been successfully deleted."
    else
      error "Deletion failed."
      status=1
    fi
    test -e /tmp/$SPT_THIS mv $_ $SCRIPTS_DIR
    return $status
  else
    if [[ $confirm == once && $spt_argc -gt 1 ]]; then # if there's only one script to delete, confirmation can be requested within the for loop instead
      read -N1 -p "delete $spt_argc scripts? (y/n) " ANS; echo
      [[ ${ANS,,} != y ]] && info 'deletion canceled' && return 1
    fi
  fi

  for sptfile in ${SPT_CMD_ARGS[@]}; do
    status=0
    get_filename &>/dev/null || continue
    if [[ ${#sptpaths[@]} -eq 0 ]]; then
      status=1
      error "cannot delete $sptfile: pattern not found"
      continue
    fi

    for sptfile in ${sptpaths[@]}; do
      sptpath=$SCRIPTS_DIR/$sptfile
      [[ ! -f $sptpath ]] && error "cannot delete $sptfile: no such script"   && status=1                    && continue
      $confirm_all        && read -N1 -p "delete script $sptfile? (y/n) " ANS && echo && [[ ${ANS,,} != y ]] && continue

      sptnum=${SPT_ENUM_NUMBERS[$sptfile]}
      if (cd $SCRIPTS_DIR && IFS=' ' rm -f ${SPT_ENUM_SCRIPTS[$sptnum]}) && # deletes script, all links to it, and all backups
         (cd $SCRIPTS_BUP && IFS=' ' rm -f ${SPT_ENUM_SCRIPTS[$sptnum]})
      then
        spt_enumdb_clear $sptnum
        SPT_ENUM_NES=$sptnum
        SPT_ENUM_SCRIPTS[$sptnum]=$SPT_ENUM_EMPTY
        SPT_ENUM_NUMBERS[$SPT_ENUM_EMPTY]=$SPT_ENUM_NES

        success "deleted $sptfile (enum #$sptnum)"
      fi
    done
  done

  return $status
}


# =========================== RENAME AND LINK ===========================

spt_rename() {
  local sptname newname sptnum pairs=$#

  while (( pairs > 0 )); do
    sptname=$1 newname=$2
    [[ -z $newname ]] && sptname=$SPT_THIS newname=$1 || { sptname=$(get_filename $1) || continue; }

    if mv -v $SCRIPTS_DIR/{$sptname,$newname}; then
      mv -v $SCRIPTS_BUP/{$sptname,$newname}
      sptnum=${SPT_ENUM_NUMBERS[$sptname]}
      spt_enumdb_rename $sptnum $sptname $newname
    fi

    shift 2
    (( pairs -= 2 ))
  done
}

spt_link() {
  local -a lnflags
  local force=${SPTCFG[link/force]} symbolic=${SPTCFG[link/symbolic]} symchain=${SPTCFG[link/symchain]} mode=link
  local sptname lnkname status sptnum

  while spt_getopt 'fforce;oonelink;ssymbolic;lhard;cchain;Cno-chain;uunlink' $@; do
    case $spt_opt in
      f) force=true;;
      o) force=false;;
      s) symbolic=true;;
      l) symbolic=false;; # -h cannot be used for --hard because -h is already for command help
      c) symchain=true;;
      C) symchain=false;;
      u) mode=unlink;;
    esac
  done

  $force    && lnflags+=(-f)
  $symbolic && lnflags+=(-s)
  $symchain && lnflags+=(-n)

  if [[ $mode == link ]]; then
    spt_argi=0
    while (( spt_argi < spt_argc - 1 )); do
      sptname=${SPT_CMD_ARGS[$((spt_argi++))]}
      lnkname=${SPT_CMD_ARGS[$((spt_argi++))]}
      [[ -z $lnkname ]] && spt_error "Error: no link specified for scriptfile $sptname; ignoring..." && status=1 && continue
      get_filename $sptname; sptname=${sptpaths[0]}
      if ln ${lnflags[@]} $sptname $SCRIPTS_DIR/$lnkname &&
         ln ${lnflags[@]} $sptname $SCRIPTS_BUP/$lnkname
      then
        sptnum=${SPT_ENUM_NUMBERS[$sptname]}
        sptname=${SPT_ENUM_SCRIPTS[$sptnum]}
        SPT_ENUM_NUMBERS[$lnkname]=$sptnum
        SPT_ENUM_SCRIPTS[$sptnum]+=" $lnkname"
        sed -ri "$((sptnum+1)) s/$sptname/$sptname $lnkname/" $SPT_ENUM_FILE
        status=0
      else
        status=1
      fi
    done
  else
    for lnkname in ${SPT_CMD_ARGS[@]}; do
      sptpath=$SCRIPTS_DIR/$lnkname
      if $symbolic && [[ ! -L $sptpath ]]; then
        spt_warn "(unlink mode): $lnkname: not a symbolic link; ignoring..."; status=1
      elif ! $symbolic && [[ -L $sptpath ]]; then
        spt_warn "(unlink mode): $lnkname: not a hard link; ignoring..."; status=1
      else
        if unlink $sptpath && unlink $SCRIPTS_BUP/$lnkname; then
          status=0
	  sptnum=${SPT_ENUM_NUMBERS[$lnkname]}
          sptname=${SPT_ENUM_SCRIPTS[$sptnum]}
	  unset SPT_ENUM_NUMBERS\[$lnkname\]
	  SPT_ENUM_SCRIPTS[$sptnum]=${sptname/ $lnkname/}
	  sed -ri "$((sptnum+1)) s/ $lnkname//" $SPT_ENUM_FILE
        else
          status=1
	fi
      fi
    done
  fi

  return $status
}


# =========================== LIST AND VIEW ===========================

spt_list() {
  local -a opts=(-l --date=relative) dirs matches dirc
  local dir=${SPTCFG[list/dir]} sort=${SPTCFG[list/sort]} pattern

  while spt_getopt 'sscripts;bbackup;Bboth;nname;dadate;Drdate' $@; do
    case $spt_opt in
      s) dir=scripts;;
      b) dir=backup;;
      B) dir=both;;
      n) sort=name;;
      d) sort=date-abs;;
      D) sort=date-rel;;
    esac
  done

  [[ $dir =~ (scripts|both) ]] && dirs=($SCRIPTS_DIR)
  [[ $dir =~ (backup|both)  ]] && dirs+=($SCRIPTS_BUP)
  dirc=${#dirs[@]}

  case ${sort:5} in
    abs) opts+=(--sort=time "--date=+%a %d %b %Y, %H:%M" --reverse);;
    rel) opts+=(--sort=time --reverse);;
  esac

  if test -n "$spt_arg"; then
    if spt_isnum $_ || spt_isrange $_; then
      spt_enum_get $_ pattern
      for ((i=0; i<dirc; ++i)); do
        matches+=(${dirs[$i]}/$pattern)
      done
    else
      pattern="$_"
      local singledir=true
      (( dirc > 1 )) && singledir=false
      for ((i=0; i<dirc; ++i)); do
        cd ${dirs[$i]} || return 1
        IFS=' ' matches=($(echo *$pattern*))
        [[ ${#matches[@]} -gt 0 ]] && break

        local msg="no match for \"$pattern\""
        $singledir || msg+=" in ${PWD/$SCRIPTS_DIR/\$SCRIPTS_DIR}"
        spt_error $msg
        return 1
      done
    fi

    dirs=(${matches[@]})
  fi

  exec lsd "${opts[@]}" ${dirs[@]}
}

spt_view() {
  local -a viewer sptpaths
  local mode=${SPTCFG[view/mode]}

  while spt_getopt 'Lleast;lless;mmore;Mmost' $@; do
    case $spt_opt in
      L) mode=simple;;
      l) mode=paged;;
      m) mode=color;;
      M) mode=pagedcolor;;
    esac
  done

  case $mode in
    simple)     viewer=(cat);;
    paged)      viewer=(less -FR);;
    color)      viewer=(bat --style=plain --paging=never);;
    pagedcolor) viewer=(bat --style=full  --paging=auto);;
  esac

  if [[ -z $spt_arg ]]; then
    ${viewer[@]} $SPT_PATH
  else
    cd $SCRIPTS_DIR || return 1
    if [[ $spt_arg == all ]]; then
      ${viewer[@]} -- *
    else
      for sptfile in ${SPT_CMD_ARGS[@]}; do
        get_filename || continue
        if [[ ${#sptpaths[@]} -eq 0 ]]; then
          spt_error "$sptfile: pattern not found"
        else
          ${viewer[@]} ${sptpaths[@]}
        fi
      done
    fi
  fi
}



# ======================================================================================
# =========================== MAIN FUNCTION AND MAIN HELPERS ===========================
# ======================================================================================


spt_msg() {
  local -i funclevel=2
  [[ $1 == -e ]] && local sptcolor="$esptcolor" endcolor="$eendcolor" msgcolor="$emsgcolor" && shift
  local colorcode=$1 msg="$2"
  [[ $2 == --up ]] && { [[ $3 =~ ^[0-9]+$ ]] && funclevel+=$3 msg="$4" || funclevel+=1 msg="$3"; }
  printf "$sptcolor%s $endcolor[at %s]: $msgcolor%s$endcolor\n" $SPT_THIS ${FUNCNAME[$funclevel]} $colorcode "$msg"
}

spt_error() { spt_msg -e "$red" "$@" >&2; }
spt_die()   { spt_msg -e "$red" "$@" >&2 && exit 1; }
spt_debug() { spt_msg -e "$grn" "DEBUG: $1" >&2 && exit 1; }
spt_warn()  { spt_msg "$ylw" "$@"; }

spt_is_file_empty() {
  stat $1
  (( ${STAT[size]} == 0 )) && return 0
  local IFS=''
  [[ -z $(cat $1) ]]
}

spt_main() {
  # =========================== INITIALIZATION OF THE CORE VARIABLES ===========================
  shopt -s nullglob
  IFS=$'\n'
  declare SPT_RERUN=false
  if [[ -v SPT_THIS ]]; then SPT_RERUN=true; fi

  $SPT_RERUN || declare SPT_PATH=$0 SPT_THIS=$(basename $0) SPT_THIS_NUMBER SPT_VERSION=1.1 SPT_VDATE="August 13th, 2026" SPT_AUTHOR="Paulo A. Lacerda (pauloaug.dev@proton.me)"
  [[ -z $1 ]] && spt_usage && exit

  declare -g sptcolor  msgcolor=%s%s  endcolor  istty_in=false istty_out=false
  declare -g sptecolor emsgcolor=%s%s eendcolor istty_err=false
  declare -g red grn ylw blu

  tty -s <&0 && istty_in=true
  tty -s <&1 && istty_out=true grn=32 ylw=33 blu=34  sptcolor="\e[0;34m"  msgcolor="\e[1;%sm%s"  endcolor="\e[0m"
  tty -s <&2 && istty_err=true grn=32 red=31 blu=34 esptcolor="\e[0;34m" emsgcolor="\e[1;%sm%s" eendcolor="\e[0m"

  # =========================== BUILTIN LOADING ===========================

  if ! $SPT_RERUN; then
    enable -f /usr/lib/bash/stat     stat
    enable -f /usr/lib/bash/basename basename
    enable -f /usr/lib/bash/dirname  dirname
    enable -f /usr/lib/bash/unlink   unlink
    enable -f /usr/lib/bash/sleep    sleep
  fi

  # =========================== CONFIGURATION FILE ===========================

  if ! $SPT_RERUN; then
    declare SPT_DEFAULT_CONFIG_FILE=~/.config/spt.conf
    [[ -v SPTCFG_FILE ]] || declare SPTCFG_FILE=$SPT_DEFAULT_CONFIG_FILE
    stat -A SPTCFG_STAT $SPTCFG_FILE
    declare -A SPTCFG; declare -a SPTCFG_NAMES # unordered and ordered
    sptcfg_load
  fi

  # =========================== SCRIPTS DIRECTORY ===========================

  [[ -v  SCRIPTS_DIR ]] || declare SCRIPTS_DIR=${SPTCFG[path/spts-origdir]}
  [[ -e $SCRIPTS_DIR ]] || spt_die "$SCRIPTS_DIR: no such file or directory"
  [[ -d $SCRIPTS_DIR ]] || spt_die "$SCRIPTS_DIR: not a directory"

  declare SCRIPTS_BUP=${SPTCFG[path/spts-bkupdir]}
  if [[ -n $SCRIPTS_BUP ]] && [[ ! -e $SCRIPTS_BUP || ! -d $SCRIPTS_BUP ]]; then
    spt_error "$SCRIPTS_BUP: invalid scripts-backup directory; ignoring..."
    unset SCRIPTS_BUP
  fi

  declare SCRIPTS_DIR_PERMS=${SPTCFG[perms/spts-origdir]} SCRIPTS_BACKUP_DIR_PERMS=${SPTCFG[perms/spts-bkupdir]}

  # =========================== MANAGER'S COMMAND LINE ===========================

  declare -g SPT_CMD=$1 SPT_NOSCRIPTS=false; shift
  declare -ga SPT_ARGS=($@) SPT_SCRIPTNAMES=($(ls $SCRIPTS_DIR))
  declare -gA SPT_INODES
  declare -g SPT_COUNT=${#SPT_SCRIPTNAMES[@]}

  if [[ $SPT_COUNT -eq 0 ]]; then
    SPT_NOSCRIPTS=true
    [[ $SPT_CMD =~ (config|edit|enum|enumgen|help|usage|version) ]] || spt_die "No scripts available in $SCRIPTS_DIR."
  else
    while IFS=' ' read inode sptfile; do SPT_INODES[$inode]=$sptfile; done < <(ls -i $SCRIPTS_DIR | sort)
  fi

  # =========================== ENUMERATORS AND THEIR FILE ===========================

  declare -a SPT_ENUM_SCRIPTS
  declare -A SPT_ENUM_NUMBERS

  declare -i SPT_ENUM_INC=50 # increment of the upper limit when it is reached
  declare -i SPT_ENUM_MAX=0  # current upper limit (a multiple of the increment)
  declare -i SPT_ENUM_CNT=0  # current number of non-empty enums
  declare -i SPT_ENUM_NES    # next empty slot

  declare SPT_ISNUM=false SPT_ISRANGE=false

  # the non empty-string symbol that represents an empty enum slot
  # no script can have this name because it is the path component separator
  declare SPT_ENUM_EMPTY=/
  declare SPT_ENUM_FILE=${SPTCFG[path/enum-mapping]}

  if   [[   -z $SPT_ENUM_FILE ]]; then spt_die 'Enums file path (path/enum-mapping config) not set in configuration file.'
  elif [[ ! -e $SPT_ENUM_FILE ]]; then spt_enumdb_generate -e "does not exist; creating it..."
  elif [[ ! -f $SPT_ENUM_FILE ]]; then spt_die "Error: $SPT_ENUM_FILE is not a file."
  elif spt_is_file_empty $SPT_ENUM_FILE; then spt_enumdb_generate -e "is empty; generating enums to populate it..."
  else spt_enumdb_load; fi # initialize the SPT_ENUM variables above
  ((--SPT_ENUM_MAX))

  # =========================== COMMAND EXECUTION ===========================

  case $SPT_CMD in
    del|edit|enum|link|list|view|config|rename) spt_$SPT_CMD ${SPT_ARGS[@]};; # argument-taking commands
    perms|sync|help|usage) spt_$SPT_CMD;; # argumentless commands
    enumgen) spt_enumdb_generate;;
    version)
      echo "ScriPTs Manager (spt) v$SPT_VERSION ($SPT_VDATE) by $SPT_AUTHOR"
      exit
      ;;
    *)
      spt_help -e "Error: $SPT_CMD: invalid command"
      exit 1
      ;;
  esac
}

spt_main $@
