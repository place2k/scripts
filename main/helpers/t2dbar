#!/usr/bin/bash
# T2DBAR — Talk to DBus as Root
# Based on the 'notify-send' function at <https://stackoverflow.com/a/49533938>.

chkroot.sh || exit 1

cachefile=/tmp/.dbusinfo.root

if [[ -f $cachefile ]]; then
  read display user uid <$cachefile
else
  display=":$(ls /tmp/.X11-unix/* | sed 's#/tmp/.X11-unix/X##' | head -n 1)" # Detect the name of the display in use
  user=$(who | grep '('$display')' | awk '{print $1}' | head -n 1) # Detect the user using such display
  uid=$(id -u $user) # Detect the id of the user
  printf '%s %s %d' $display $user $uid >$cachefile
fi

exec sudo -u $user DISPLAY=$display DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus "$@"