#!/bin/zsh

xhd() { /usr/bin/sudo /usr/bin/xhd.sh -$1 }

wait_exit=true
[[ $1 == --nowait ]] && wait_exit=false && shift
PROG=$1 && shift
ARGS=$@
command -v $PROG >/dev/null || exec die.sh "cannot run $PROG: no executable found"

xhd m
if $wait_exit; then
  $PROG $ARGS &
  pidwait -p $!; STATUS=$?; xhd u
  exit $STATUS
else
  ( sleep 3 && xhd u ) &!
  exec $PROG $ARGS
fi
